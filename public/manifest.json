{
  "manifest_version": 3,
  "name": "PageMemory",
  "version": "0.1.0",
  "description": "Remember where you left off.",
  "action": {
    "default_title": "PageMemory",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"]
}
